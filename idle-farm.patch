+| `collection300` | 3,363,381,028,564,256 | 1,600,000,000,000,000 | 5,000,000,000,000 | 5,000,000,000,000 |
+| `collection400` | 85,554,381,028,564,256 | 42,000,000,000,000,000 | 69,000,000,000,000 | 69,000,000,000,000 |
+| `itemCollection` | 3,676,314,381,028,564,256 | 1,800,000,000,000,000,000 | 2,800,000,000,000,000 | 2,800,000,000,000,000 |
