+      const upstream = catalog.items[inputId];
+      const [a, b] = allocated(inputId);
+      const t = BigInt(upstream.durationMs) / 1000n;
+      sum = add(sum, [BigInt(count) * (t * b + a), b * BigInt(upstream.output)]);
+    }
+    upstreamLabor.set(id, sum);
+    return sum;
+  }
