  "reproduction": {
    "tool": "Node.js + 项目开发依赖 sharp@0.34.5，通过 librsvg 合成本地静态证据，未执行游戏代码。",
    "usage": "从仓库根目录运行 Node CommonJS。common 和 recipes 的每个数组均按换行拼接。在 common 后拼接换行、(async()=>{、所选 runs 条目的 variables、对应 recipes 内容与 })();，各段用换行分隔。map 生成 icons 和三档 map，detail 生成 source-map 和 edges。",
    "common": [
      "const sharp = require('sharp');",
      "const fs = require('node:fs/promises');",
      "const crypto = require('node:crypto');",
      "const dir = 'assets/source/art/proposals/order-center/review';",
      "const digest = value => crypto.createHash('sha256').update(value).digest('hex');",
      "const result = [];",
      "const tracked = new Map();",
      "const images = new Map();",
      "async function read(path) {",
      "  if (!images.has(path)) {",
      "    const bytes = await fs.readFile(path);",
      "    const image = sharp(bytes);",
      "    const {width, height, hasAlpha} = await image.metadata();",
      "    tracked.set(path, {path, sha256:digest(bytes), width, height, hasAlpha});",
      "    const png = await image.png().toBuffer();",
      "    images.set(path, 'data:image/png;base64,'+png.toString('base64'));",
      "  }",
      "  return images.get(path);",
      "}",
      "const rect = (x,y,w,h,fill) => '<rect x=\"'+x+'\" y=\"'+y+'\" width=\"'+w+'\" height=\"'+h+'\" fill=\"'+fill+'\"/>';",
      "const group = (at,html) => '<g transform=\"'+at+'\">'+html+'</g>';",
      "async function stamp(path,x,y,w,h,fit='none'){",
      " return '<image x=\"'+x+'\" y=\"'+y+'\" width=\"'+w+'\" height=\"'+h+'\" preserveAspectRatio=\"'+fit+'\" href=\"'+await read(path)+'\"/>';",
      "}",
      "async function emit(name,w,h,html){",
      " const svg='<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"'+w+'\" height=\"'+h+'\" viewBox=\"0 0 '+w+' '+h+'\">'+html+'</svg>';",
      " const out = await sharp(Buffer.from(svg)).png().toBuffer();",
      " await fs.mkdir(dir,{recursive:true}); const path=dir+'/'+name+'.png'; await fs.writeFile(path,out);",
      " result.push({path,sha256:digest(out),width:w,height:h});",
      "}"
    ],
    "recipes": {
      "map": [
        "const art='public/art/estate/', icons='public/ui-icons/';",
        "const iconIds=['menu-merchant','menu-orders','tech-order-expansion','tech-order-negotiation','tech-order-premium','tech-merchant-bargaining'];",
        "let iconsHtml=rect(0,0,576,182,'#f2e3c1');",
        "for(const [i,id] of iconIds.entries()){",
        " for(const [y,s] of [[0,96],[103,32],[142,26]]) iconsHtml+=await stamp(icons+id+'.webp',i*96+(96-s)/2,y,s,s);",
        "}",
        "await emit('icons',576,182,iconsHtml);",
        "const sites=[",
        " ['field',[0.6731,0.8245],[39,18,497,310],0.51],",
        " ['fish',[0.6584,1.2769],[11,126,528,309],0.504,164],",
        " ['mine',[0.235,1.385],[27,37,508,309],0.38],",
        " ['orders',[0.213,1.117],[34,27,502,308],0.258],",
        "];",
        "for(const w of [320,390,414]){",
        " const height=Math.round(w*2.36),cropY=Math.round(w*0.91),h=Math.round(w*0.68);",
        " let strips='';",
        " for(const [i,angle] of [-0.095,0,0.095].entries()){",
        "  const field=await stamp(art+'background.webp',0,0,w,height);",
        "  let buildings='', signs='';",
        "  for(const [id,center,f,ratio,signX=(f[0]+f[2])/2] of sites){",
        "    const u=w*ratio/(f[2]-f[0]),x=Math.round(w*center[0]),y=Math.round(w*center[1]),left=x-268*u,top=y-160*u;",
        "    buildings+=await stamp(art+id+'.webp',left,top,536*u,320*u);",
        "    if(id==='orders'){",
        "       const px=left+199*u, py=top+79*u;",
        "       buildings+=group('rotate('+(angle*180/Math.PI)+' '+px+' '+py+')',await stamp(art+'orders-motion.webp',px-46*u,py-4*u,92*u,84*u));",
        "    }",
        "    if(id==='mine'){",
        "       const p=132*u,meta=await sharp(art+'mine-motion.webp').metadata(), scale=p/Math.max(meta.width,meta.height);",
        "       buildings+=await stamp(art+'mine-motion.webp',left+328*u-0.5*meta.width*scale,top+263*u-0.93*meta.height*scale,meta.width*scale,meta.height*scale);",
        "    }",
        "    const sw=Math.round(w*.224), sh=sw*110/516, sy=top+f[3]*u+Math.max(2,Math.round(w*.009));",
        "    signs+=await stamp(art+'sign.webp',Math.round(left+signX*u)-sw/2,sy,sw,sh);",
        "  }",
        "  strips+='<svg x=\"'+i*w+'\" y=\"0\" width=\"'+w+'\" height=\"'+h+'\" viewBox=\"0 '+cropY+' '+w+' '+h+'\">'+field+buildings+signs+'</svg>';",
        " }",
        " await emit('map-'+w,w*3,h,strips);",
        "}"
      ],
      "detail": [
        "const src='assets/source/art/order-center/';",
        "let comparison=rect(0,0,1000,485,'#efe2cc');",
        "comparison+=await stamp('public/art/estate/tasks.webp',0,0,210,135,'xMidYMid meet');",
        "comparison+=await stamp('public/art/estate/mine.webp',0,155,210,135,'xMidYMid meet');",
        "comparison+=await stamp(src+'building.png',210,0,340,240,'xMidYMid meet');",
        "comparison+=await stamp(src+'pendant.png',240,245,227,227,'xMidYMid meet');",
        "comparison+=await stamp(src+'icon-grid.png',550,0,450,450,'xMidYMid meet');",
        "await emit('source-map',1000,485,comparison);",
        "const edgeBase=await sharp('public/art/estate/orders.webp').extract({left:166,top:16,width:105,height:110}).resize(315,330,{kernel:'nearest'}).flatten({background:'#e8dcbd'}).png().toBuffer();",
        "const edgeMotion=await sharp('public/art/estate/orders-motion.webp').resize(276,252,{kernel:'nearest'}).flatten({background:'#e8dcbd'}).png().toBuffer();",
        "const edgeIcon=await sharp('public/ui-icons/menu-orders.webp').resize(288,288,{kernel:'nearest'}).flatten({background:'#e8dcbd'}).png().toBuffer();",
        "const embed=(bytes,x,y,w,h)=>'<image x=\"'+x+'\" y=\"'+y+'\" width=\"'+w+'\" height=\"'+h+'\" href=\"data:image/png;base64,'+bytes.toString('base64')+'\"/>';",
        "await emit('edges',879,330,rect(0,0,879,330,'#e8dcbd')+embed(edgeBase,0,0,315,330)+embed(edgeMotion,315,0,276,252)+embed(edgeIcon,591,0,288,288));"
      ]
    },
